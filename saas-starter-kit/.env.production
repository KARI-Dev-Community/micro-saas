# ---- Application ----
NODE_ENV=production
PORT=3001
API_PREFIX=api
FRONTEND_URL=https://your-domain.com

# ---- JWT ----
JWT_SECRET=change-me-to-a-secure-secret-key-here-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Database (postgres | mysql) ----
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=saas
DB_PASSWORD=saas
DB_DATABASE=saas
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Auth / Social ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FREE_PROJECT_LIMIT=3

# ---- AI ----
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini

# ---- Email ----
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@saas.dev

# ---- Storage ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BASE_URL=http://localhost:3001/files

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Security ----
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_ENABLED=true
CSRF_COOKIE_NAME=__Host-csrf-token
RATE_LIMIT_TTL=60000
RATE_LIMIT_GLOBAL_LIMIT=120
RATE_LIMIT_AUTH_TTL=60000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_STRICT_TTL=60000
RATE_LIMIT_STRICT_LIMIT=30
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
INTERNAL_SIGNING_SECRET=change-me-to-a-secure-signing-secret-key-here-32-chars
INTERNAL_TOLERANCE_MS=300000
SESSION_DEVICE_BINDING=false
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_TIMEOUT_MS=86400000
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,application/pdf
UPLOAD_MAGIC_BYTE_VALIDATION=true
UPLOAD_MALWARE_SCAN=false
LOG_BODY_MAX_BYTES=1024
LOG_PII_EXCLUDE_FIELDS=password,token,secret,key,authorization,cookie
KILL_SWITCH_ENABLED=false
KILL_SWITCH_ENDPOINTS=